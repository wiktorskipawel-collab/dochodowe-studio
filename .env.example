# Skopiuj ten plik jako .env.local i uzupełnij. Pliku .env.local NIE wysyłamy na GitHub.

# Klucz do OpenAI API (platform.openai.com → API keys). Wklejasz go tylko tutaj, nigdy do czatu.
OPENAI_API_KEY=

# Modele: rozmowa (tani) i materiały (mocniejszy). Zmiana modelu = zmiana tej linijki.
OPENAI_MODEL_CHAT=gpt-5-mini
OPENAI_MODEL_WRITER=gpt-5-mini
# low | medium | high (puste = bez ustawienia, dla modeli, które tego nie obsługują)
OPENAI_REASONING_EFFORT=low

# Hasło do całej strony na czas pokazów (puste = bez hasła). Zastąpi je logowanie w Supabase.
SITE_PASSWORD=
