# Skopiuj jako .env.local (lokalnie) i wpisz te same wartości w Vercel → Settings → Environment Variables.
# Pliku .env.local NIE wysyłamy na GitHub.

# Supabase (Project Settings → API). Bez nich aplikacja działa w trybie lokalnym (prototyp).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Szyfrowanie ciasteczka z kluczem AI uczestnika (min. 32 losowe znaki). WYMAGANE na produkcji.
COOKIE_SECRET=

# AI PLATFORMY: jeden klucz OpenRouter (openrouter.ai → Keys, ustaw limit wydatków na kluczu).
# Gdy NEXT_PUBLIC_AI_MODEL jest wpisany, uczestnicy niczego nie łączą — rozmawiają na koszt platformy (tylko zalogowani).
OPENROUTER_API_KEY=
NEXT_PUBLIC_AI_MODEL=deepseek/deepseek-v3.2

# Kalendarz Bartka do rozmów 30 min po kamieniu milowym (np. link z Calendly) i wideo powitalne (adres odtwarzacza).
NEXT_PUBLIC_BARTEK_KALENDARZ=
NEXT_PUBLIC_WIDEO_POWITALNE=

# Opcjonalnie: stary tryb (uczestnik łączy własne AI) — klucze zapasowe.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hasło do całej strony na czas testów (puste = bez hasła).
SITE_PASSWORD=
