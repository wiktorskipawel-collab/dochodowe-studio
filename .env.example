# Skopiuj ten plik jako .env.local. Pliku .env.local NIE wysyłamy na GitHub.
# Wszystko jest opcjonalne: uczestnicy podłączają własne AI w aplikacji (/start).

# Klucz platformy na pokazy — używany tylko wtedy, gdy uczestnik nie podał własnego.
# Wklejasz go tylko tutaj, nigdy do czatu.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hasło do całej strony na czas pokazów (puste = bez hasła). Zastąpi je logowanie w Supabase.
SITE_PASSWORD=
