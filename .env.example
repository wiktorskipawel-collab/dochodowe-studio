# Skopiuj ten plik jako .env.local. Pliku .env.local NIE wysyłamy na GitHub.

# Szyfrowanie ciasteczka z kluczem AI uczestnika (min. 32 losowe znaki). WYMAGANE na produkcji.
COOKIE_SECRET=

# Opcjonalnie: klucze platformy na pokazy — używane tylko, gdy uczestnik nie połączył własnego AI.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hasło do całej strony na czas pokazów (puste = bez hasła). Zastąpi je logowanie w Supabase.
SITE_PASSWORD=
